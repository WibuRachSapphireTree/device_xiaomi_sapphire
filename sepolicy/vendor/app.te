get_prop({ appdomain -isolated_app_all }, vendor_fp_prop)
get_prop({ appdomain -isolated_app_all }, vendor_tee_listener_prop)

# Allow platform_app (com.qualcomm.qti.poweroffalarm) to find alarm service
# Fixes: avc denied { find } for vendor_qti_poweroffalarm_app tcontext=default_android_service
allow platform_app vendor_qti_alarm_service:service_manager find;
